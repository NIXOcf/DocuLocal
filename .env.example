POSTGRES_USER=doculocal
# Valores de desarrollo local: la BD solo se publica en 127.0.0.1. Cambiar la contraseña fuera de la demo.
POSTGRES_PASSWORD=doculocal_dev
POSTGRES_DB=doculocal
# 127.0.0.1 y no localhost: en Windows 'localhost' prueba primero IPv6 y cada conexión tarda ~5 s.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# OBLIGATORIO: pegar un secreto aleatorio de 32+ caracteres (py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"). Vacío, la API no arranca.
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
CORS_ORIGINS=http://localhost:5173

STORAGE_DIR=backend/storage
MAX_UPLOAD_MB=20

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Puntaje minimo (logit del cross-encoder jina-reranker-v2) para considerar relevante un fragmento.
# Calibrado con consultas reales sobre docs/prueba: los fragmentos relevantes puntuan entre +0.2 y +0.9 (el mejor);
# los irrelevantes o fuera de tema quedan bajo -1.4 (el mejor); uno solo parcialmente relacionado llego a -0.47.
# -1.3: las preguntas coloquiales/en primera persona puntuan bajo aun con evidencia (-0.9 a -1.2); el reranker ya no es el unico filtro:
# el planificador reescribe la pregunta en forma impersonal y el prompt obliga a responder 'no encontre' si ningun fragmento trata el asunto. Antes -0.4.
RERANK_MIN_SCORE=-1.3
RETRIEVAL_TOP_K=8

GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Cliente LLM: segundos de espera por llamada y reintentos (en modo local las respuestas largas tardan: usar 180)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Swagger (/docs), ReDoc y /openapi.json. Por defecto (sin esta variable) quedan desactivados; true solo en desarrollo/demo.
ENABLE_DOCS=false

# Logs (consola + archivo rotativo LOG_DIR/doculocal.log). LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=backend/logs

# --- Modo local (llama.cpp): privacidad total, sin clave. Levantar con backend/scripts/llama_local.ps1 ---
# GROQ_API_KEY puede ir vacía. El detector de inyección no existe en local (LLM_GUARD_MODEL vacío lo desactiva).
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_MODEL=local
# LLM_FAST_MODEL=local
# LLM_GUARD_MODEL=
# LLM_TIMEOUT_SECONDS=180

# Frontend (Vite): URL base de la API
VITE_API_URL=http://localhost:8000/api/v1
