            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"trabajador@aguanube.cl\",\n  \"password\": \"DocuLocal2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
